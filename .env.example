# PostgreSQL
POSTGRES_USER=monitor
POSTGRES_PASSWORD=changeme_monitor_password
POSTGRES_DB=monitoring
DATABASE_URL=postgresql+asyncpg://monitor:changeme_monitor_password@postgres:5432/monitoring

# Grafana
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana_password

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=alerts@monitoring.local
SMTP_TO_EMAIL=admin@example.com

# Recovery
RECOVERY_ENABLED=false
RECOVERY_DRY_RUN=true
RECOVERY_COOLDOWN_SECONDS=300
ALLOWED_RECOVERY_HOSTS=app-server-01,db-server-01,192.168.56.11,192.168.56.12
ALLOWED_RECOVERY_SERVICES=nginx,apache2,postgresql,mysql,redis-server

# SSH
# In Docker Compose the key is mounted at /run/secrets/recovery_key (see docker-compose.yml)
SSH_KEY_PATH=keys/recovery_id_rsa
# Optional: known_hosts file for strict host-key checking
# SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts
SSH_USERNAME=monitor
SSH_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Number of backend (uvicorn) worker processes; cooldown state is shared through PostgreSQL
BACKEND_WORKERS=4
