FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install essential tools, stress-ng, nginx, python, openssh, curl, sudo
RUN apt-get update && apt-get install -y \
    openssh-server \
    sudo \
    curl \
    wget \
    stress-ng \
    nginx \
    procps \
    iproute2 \
    systemd-sysv \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download and install Node Exporter v1.8.2
RUN wget -q https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz -O /tmp/node_exporter.tar.gz \
    && tar -xzf /tmp/node_exporter.tar.gz -C /tmp \
    && mv /tmp/node_exporter-1.8.2.linux-amd64/node_exporter /usr/local/bin/ \
    && rm -rf /tmp/node_exporter*

# Service account for the recovery engine: no password (key-only login) and
# passwordless sudo restricted to the exact commands the playbooks use.
RUN useradd -m -s /bin/bash monitor \
    && passwd -l monitor \
    && echo 'monitor ALL=(root) NOPASSWD: /usr/bin/systemctl, /usr/sbin/service, /usr/bin/find, /usr/bin/journalctl' \
       > /etc/sudoers.d/monitor \
    && chmod 0440 /etc/sudoers.d/monitor \
    && visudo -cf /etc/sudoers.d/monitor

# Configure SSH: public-key authentication only, no root login.
# keys/recovery_id_rsa.pub is generated by scripts/setup_monitoring.sh.
COPY keys/recovery_id_rsa.pub /home/monitor/.ssh/authorized_keys
RUN mkdir -p /var/run/sshd \
    && ssh-keygen -A \
    && sed -i -E 's/^#?PasswordAuthentication .*/PasswordAuthentication no/; s/^#?PermitRootLogin .*/PermitRootLogin no/; s/^#?PubkeyAuthentication .*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && chown -R monitor:monitor /home/monitor/.ssh \
    && chmod 700 /home/monitor/.ssh \
    && chmod 600 /home/monitor/.ssh/authorized_keys

# Startup script to run sshd, nginx, service watcher, and node_exporter
COPY <<'EOF' /entrypoint.sh
#!/bin/bash
set -e

# Start SSH daemon
/usr/sbin/sshd

# Start Nginx
service nginx start

# Create textfile collector directory for real-time service metrics
mkdir -p /var/lib/node_exporter/textfile_collector

# Background service health watcher: checks nginx process every 2 seconds
(
  while true; do
    if pgrep -x nginx >/dev/null 2>&1; then
      ACTIVE=1
      FAILED=0
    else
      ACTIVE=0
      FAILED=1
    fi
    cat << EOF2 > /var/lib/node_exporter/textfile_collector/services.prom.tmp
# HELP node_systemd_unit_state State of monitored services
# TYPE node_systemd_unit_state gauge
node_systemd_unit_state{name="nginx.service",state="active"} $ACTIVE
node_systemd_unit_state{name="nginx.service",state="failed"} $FAILED
EOF2
    mv /var/lib/node_exporter/textfile_collector/services.prom.tmp /var/lib/node_exporter/textfile_collector/services.prom
    sleep 2
  done
) &

# Start Node Exporter with textfile collector enabled
/usr/local/bin/node_exporter \
  --collector.textfile.directory=/var/lib/node_exporter/textfile_collector \
  --web.listen-address="0.0.0.0:9100" &

echo "=========================================================="
echo " Ubuntu Target VM is RUNNING!"
echo " - Node Exporter: port 9100 (service telemetry enabled)"
echo " - Nginx Service: port 80"
echo " - SSH Service:   port 22 (user: monitor, key-based login only)"
echo "=========================================================="

# Keep container alive
tail -f /dev/null
EOF

RUN chmod +x /entrypoint.sh

EXPOSE 22 80 9100

CMD ["/entrypoint.sh"]
